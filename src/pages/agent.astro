---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="AI 工坊已迁移" description="AI 工坊已并入实验手记">
  <div class="migration">
    <h1>AI 工坊已并入实验手记</h1>
    <p>原 AI 工坊内容已经并入实验手记。</p>
    <p class="hint">与 Autumn、Agent 和自动化工作流相关的内容，现在统一放在 <a href="/lab">实验手记</a>。</p>
    <a href="/lab" class="back-link">→ 前往实验手记</a>
  </div>
</BaseLayout>

<style>
  .migration { max-width: 38rem; padding: 4rem 0; }
  .migration h1 { margin-bottom: 0.8rem; font-size: 1.8rem; letter-spacing: -0.03em; }
  .migration p { margin-bottom: 0.55rem; color: var(--color-text-muted); font-size: 0.9rem; }
  .hint { font-size: 0.85rem; }
  .back-link { display: inline-block; margin-top: 1rem; color: var(--color-accent-strong); font-size: 0.85rem; text-decoration: none; }
</style>
