---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  return allPosts
    .filter(post => !post.data.draft)
    .map(post => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const wordCount = post.body.replace(/\s+/g, '').length;
const readingTime = Math.ceil(wordCount / 500);
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

const publishDate = post.data.date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const updatedDate = post.data.updated
  ? post.data.updated.toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const sectionLabels: Record<string, string> = {
  lab: '实验手记',
  study: '通识基础',
  mind: '随想录',
  project: '作品集',
};
---

<BaseLayout title={post.data.title} description={post.data.description}>
  {tocHeadings.length > 1 && (
    <nav class="toc-fixed" aria-label="文章目录">
      <p class="toc-title">目录</p>
      <ul class="toc-list">
        {tocHeadings.map(h => (
          <li class={h.depth === 3 ? 'toc-h3' : ''}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <article class="post-article">
    <header class="article-header">
      <p class="section-kicker">{sectionLabels[post.data.section] ?? post.data.section}</p>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>

      <ul class="article-meta">
        <li><time datetime={post.data.date.toISOString()}>{publishDate}</time></li>
        {updatedDate && <li>更新于 {updatedDate}</li>}
        <li>{readingTime} 分钟</li>
      </ul>

      <ul class="tag-list">
        {post.data.tags.map(tag => (
          <li><a href={`/tags/${tag}`} class="tag">{tag}</a></li>
        ))}
      </ul>
    </header>

    {tocHeadings.length > 1 && (
      <details class="toc-mobile">
        <summary>本页目录</summary>
        <ul>
          {tocHeadings.map(h => (
            <li class={h.depth === 3 ? 'toc-h3' : ''}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </details>
    )}

    <div class="article-text">
      <Content />
    </div>
  </article>

  <div class="comments-wrap">
    <Comments title={post.data.title} />
  </div>
</BaseLayout>

<script>
  document.querySelectorAll('pre').forEach(pre => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block-wrapper';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.type = 'button';
    btn.textContent = '复制';
    btn.setAttribute('aria-label', '复制代码');

    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code');
      const text = code ? code.innerText : pre.innerText;

      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = '已复制 ✓';
        btn.classList.add('copied');
        setTimeout(() => {
          btn.textContent = '复制';
          btn.classList.remove('copied');
        }, 1600);
      } catch {
        btn.textContent = '复制失败';
      }
    });

    wrapper.appendChild(btn);
  });
</script>

<style>
  .post-article {
    max-width: var(--reading-max-width);
    margin: 0 auto;
    padding: 3.4rem 0 4rem;
  }

  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1.3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-kicker {
    margin-bottom: 0.5rem;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .article-header h1 {
    margin-bottom: 0.65rem;
    border: 0;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    letter-spacing: -0.035em;
  }

  .article-description {
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    font-size: 0.98rem;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0 0 0.85rem;
    padding: 0;
    color: var(--color-text-faint);
    font-size: 0.75rem;
    list-style: none;
  }

  .article-meta li {
    margin: 0;
  }

  .article-meta time {
    color: inherit;
  }

  .article-text {
    line-height: 1.86;
  }

  .toc-fixed {
    position: fixed;
    top: calc(var(--nav-height) + 2rem);
    left: max(1rem, calc((100vw - var(--site-max-width)) / 2 - 13rem));
    width: 11.5rem;
    max-height: calc(100vh - var(--nav-height) - 4rem);
    overflow-y: auto;
    z-index: 5;
    font-size: 0.78rem;
  }

  .toc-title {
    margin: 0 0 0.5rem;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .toc-list {
    margin: 0;
    padding: 0 0 0 0.1rem;
    border-left: 1px solid var(--color-border);
    list-style: none;
  }

  .toc-list li {
    margin: 0;
  }

  .toc-list a {
    display: block;
    margin-left: -1px;
    padding: 0.24rem 0 0.24rem 0.7rem;
    border-left: 2px solid transparent;
    color: var(--color-text-muted);
    line-height: 1.45;
    text-decoration: none;
  }

  .toc-list a:hover {
    border-left-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .toc-list .toc-h3 a {
    padding-left: 1.25rem;
    font-size: 0.74rem;
  }

  .toc-mobile {
    display: none;
    margin: 0 0 1.5rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background: var(--color-surface);
  }

  .toc-mobile summary {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    cursor: pointer;
  }

  .toc-mobile ul {
    margin: 0.65rem 0 0;
    padding-left: 1rem;
  }

  .toc-mobile li {
    margin: 0.22rem 0;
    font-size: 0.78rem;
  }

  .toc-mobile .toc-h3 {
    margin-left: 0.8rem;
  }

  .comments-wrap {
    max-width: var(--reading-max-width);
    margin: 0 auto;
  }

  @media (max-width: 1180px) {
    .toc-fixed {
      display: none;
    }

    .toc-mobile {
      display: block;
    }
  }
</style>

<style is:global>
  .code-block-wrapper {
    position: relative;
    margin: 1.35rem 0;
  }

  .code-block-wrapper > pre {
    margin: 0;
  }

  .copy-btn {
    position: absolute;
    top: 0.45rem;
    right: 0.45rem;
    z-index: 10;
    padding: 0.24rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 0.38rem;
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    color: var(--color-text-muted);
    font-family: inherit;
    font-size: 0.68rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s, color 0.15s, border-color 0.15s;
  }

  .code-block-wrapper:hover .copy-btn,
  .copy-btn:focus-visible {
    opacity: 1;
  }

  .copy-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .copy-btn.copied {
    color: var(--color-accent-strong);
  }

  @media (hover: none) {
    .copy-btn {
      opacity: 1;
    }
  }
</style>
