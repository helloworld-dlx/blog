---
import BaseLayout from '../layouts/BaseLayout.astro';
import { changelog } from '../data/changelog';
import type { ChangelogType } from '../data/changelog';

const typeLabel: Record<ChangelogType, string> = {
  site: '站点',
  content: '内容',
  deploy: '部署',
  fix: '修复',
};

const grouped = changelog.reduce<Record<string, typeof changelog>>((acc, entry) => {
  const key = entry.date.slice(0, 7);
  if (!acc[key]) acc[key] = [];
  acc[key].push(entry);
  return acc;
}, {});

const months = Object.keys(grouped).sort().reverse();
for (const month of months) {
  grouped[month].sort((a, b) => b.date.localeCompare(a.date));
}
---

<BaseLayout title="Changelog" description="博客更新历史记录">
  <div class="changelog">
    <p class="kicker">Changelog</p>
    <h1>更新日志</h1>
    <p class="intro">博客结构、部署与功能的变更记录。</p>

    {months.map(month => (
      <section class="month-group">
        <h2 class="month-label">{month}</h2>
        <div class="entries">
          {grouped[month].map(entry => (
            <div class="entry">
              <div class="entry-meta">
                <span class="type-badge">{typeLabel[entry.type]}</span>
                <time datetime={entry.date}>{entry.date}</time>
              </div>
              <h3>{entry.title}</h3>
              <p>{entry.description}</p>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .changelog {
    max-width: 42.5rem;
    margin: 0 auto;
    padding: 3.5rem 0 4.5rem;
  }

  .kicker {
    margin-bottom: 0.35rem;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 0.45rem;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }

  .intro {
    margin-bottom: 2.6rem;
    color: var(--color-text-muted);
    font-size: 0.86rem;
  }

  .month-group {
    margin-bottom: 2.4rem;
  }

  .month-label {
    margin-bottom: 1rem;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .entries {
    padding-left: 1.1rem;
    border-left: 1px solid var(--color-border);
  }

  .entry {
    position: relative;
    padding: 0 0 1.8rem;
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  .entry::before {
    content: '';
    position: absolute;
    left: -1.38rem;
    top: 0.35rem;
    width: 0.48rem;
    height: 0.48rem;
    border: 2px solid var(--color-bg);
    border-radius: 50%;
    background: var(--color-accent);
  }

  .entry-meta {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.35rem;
  }

  .type-badge {
    padding: 0.1rem 0.4rem;
    border-radius: 2rem;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
    font-size: 0.66rem;
  }

  .entry time {
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .entry h3 {
    margin-bottom: 0.25rem;
    font-size: 0.95rem;
  }

  .entry p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.83rem;
  }
</style>
