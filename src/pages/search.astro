---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts');
const publishedPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const searchData = publishedPosts.map(post => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags,
  section: post.data.section,
  date: post.data.date.toISOString(),
}));
---

<BaseLayout title="搜索" description="搜索文章">
  <div class="search-page">
    <p class="kicker">Search</p>
    <h1>搜索</h1>

    <div class="search-input-wrap">
      <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <circle cx="11" cy="11" r="7.2" />
        <path d="m16.4 16.4 4.1 4.1" />
      </svg>
      <input type="search" id="search-input" placeholder="输入关键词搜索..." autocomplete="off" />
    </div>

    <div id="results">
      <div class="empty-state">
        <p>输入关键词开始搜索</p>
      </div>
    </div>
  </div>

  <script define:vars={{ searchData }}>
    const input = document.getElementById('search-input');
    const results = document.getElementById('results');

    const sectionLabels = {
      lab: '实验手记',
      study: '通识基础',
      mind: '随想录',
      project: '作品集',
    };

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function renderPosts(posts) {
      if (!results) return;

      if (posts.length === 0) {
        results.innerHTML = '<div class="empty-state"><p>没有找到匹配的文章</p></div>';
        return;
      }

      results.innerHTML =
        '<div class="results-list">' +
        posts.map(post => {
          const date = new Date(post.date).toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
          });
          const section = sectionLabels[post.section] || post.section;
          const tags = post.tags.slice(0, 3).map(tag => '#' + escapeHtml(tag)).join(' · ');

          return (
            '<a href="/posts/' + encodeURI(post.id) + '" class="result-row">' +
              '<time>' + escapeHtml(date) + '</time>' +
              '<div class="result-copy">' +
                '<h2>' + escapeHtml(post.title) + '</h2>' +
                '<p>' + escapeHtml(post.description) + '</p>' +
              '</div>' +
              '<div class="result-meta"><span>' + escapeHtml(section) + '</span><small>' + tags + '</small></div>' +
            '</a>'
          );
        }).join('') +
        '</div>';
    }

    function search(query) {
      if (!results) return;
      const normalized = query.trim().toLowerCase();

      if (!normalized) {
        results.innerHTML = '<div class="empty-state"><p>输入关键词开始搜索</p></div>';
        return;
      }

      const matched = searchData.filter(post =>
        post.title.toLowerCase().includes(normalized) ||
        post.description.toLowerCase().includes(normalized) ||
        post.tags.some(tag => tag.toLowerCase().includes(normalized))
      );

      renderPosts(matched);
    }

    input?.addEventListener('input', event => {
      if (event.target instanceof HTMLInputElement) search(event.target.value);
    });
  </script>
</BaseLayout>

<style is:global>
  .search-page {
    max-width: 48rem;
    margin: 0 auto;
    padding: 3.5rem 0 4.5rem;
  }

  .search-page .kicker {
    margin-bottom: 0.35rem;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .search-page > h1 {
    margin-bottom: 1.45rem;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }

  .search-input-wrap {
    position: relative;
    margin-bottom: 1.6rem;
  }

  .search-input-wrap .search-icon {
    position: absolute;
    left: 0.9rem;
    top: 50%;
    width: 21px;
    height: 21px;
    transform: translateY(-50%);
    color: var(--color-text-faint);
    stroke-width: 1.9;
    pointer-events: none;
  }

  .search-input-wrap input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 3rem;
    border: 1px solid var(--color-border);
    border-radius: 0.7rem;
    outline: 0;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.95rem;
  }

  .search-input-wrap input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 13%, transparent);
  }

  .empty-state {
    padding: 3rem 0;
    color: var(--color-text-faint);
    text-align: center;
    font-size: 0.85rem;
  }

  .results-list {
    border-top: 1px solid var(--color-border);
  }

  .result-row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
  }

  .result-row:hover {
    text-decoration: none;
  }

  .result-row time {
    padding-top: 0.18rem;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .result-copy h2 {
    margin: 0 0 0.2rem;
    font-size: 0.94rem;
  }

  .result-row:hover .result-copy h2 {
    color: var(--color-accent-strong);
  }

  .result-copy p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .result-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    white-space: nowrap;
  }

  .result-meta span {
    color: var(--color-accent-strong);
  }

  .result-meta small {
    font-size: inherit;
  }

  @media (max-width: 640px) {
    .result-row {
      grid-template-columns: 5.3rem minmax(0, 1fr);
    }

    .result-meta {
      display: none;
    }
  }
</style>
