<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#101b2a" />
    <title>这里没有 PPT</title>
  </head>
  <body>
    <main>
      <div class="orbit orbit-one" aria-hidden="true"></div>
      <div class="orbit orbit-two" aria-hidden="true"></div>

      <section class="card" aria-labelledby="empty-title">
        <span class="icon" aria-hidden="true">📭</span>
        <p class="eyebrow">SLIDES HAVE LEFT THE CHAT</p>
        <h1 id="empty-title">这里没有 PPT 嘿嘿</h1>
        <p class="note">答辩结束，幻灯片先下班啦。</p>
        <button type="button">我不信</button>
      </section>

      <p class="footnote">你什么也没看到&nbsp; 👀</p>
    </main>

    <script>
      const title = document.querySelector('h1')!;
      const note = document.querySelector<HTMLElement>('.note')!;
      const button = document.querySelector('button')!;
      let revealed = false;

      button.addEventListener('click', () => {
        revealed = !revealed;
        title.textContent = revealed ? '真的没有啦 👀' : '这里没有 PPT 嘿嘿';
        note.textContent = revealed ? '再点也不会凭空变出来。' : '答辩结束，幻灯片先下班啦。';
        button.textContent = revealed ? '好吧好吧' : '我不信';
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html), :global(body) { margin: 0; min-height: 100%; }
  :global(body) {
    font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans SC", sans-serif;
    color: #f4f8ff;
    background:
      radial-gradient(circle at 20% 20%, #224a78 0, transparent 34%),
      radial-gradient(circle at 80% 75%, #173c65 0, transparent 30%),
      #101b2a;
    overflow: hidden;
  }

  main {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 24px;
    isolation: isolate;
  }

  .card {
    width: min(700px, 100%);
    padding: clamp(36px, 7vw, 72px) clamp(24px, 7vw, 64px);
    border: 1px solid #ffffff24;
    border-radius: 28px;
    text-align: center;
    background: #ffffff0d;
    box-shadow: 0 28px 80px #00000040;
    backdrop-filter: blur(12px);
  }

  .icon {
    display: inline-block;
    font-size: clamp(58px, 12vw, 92px);
    filter: drop-shadow(0 12px 20px #00000035);
    animation: bob 3s ease-in-out infinite;
  }

  .eyebrow {
    margin: 22px 0 10px;
    color: #8fc7ff;
    font: 700 clamp(10px, 2.5vw, 13px) / 1.4 Arial, sans-serif;
    letter-spacing: .18em;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 7vw, 56px);
    line-height: 1.2;
    letter-spacing: -.03em;
  }

  .note {
    min-height: 1.6em;
    margin: 22px 0 30px;
    color: #bdcce0;
    font-size: clamp(15px, 3vw, 18px);
  }

  button {
    border: 1px solid #ffffff28;
    border-radius: 999px;
    padding: 11px 22px;
    color: #f4f8ff;
    background: #ffffff12;
    font: 600 15px / 1.2 inherit;
    cursor: pointer;
    transition: transform .18s ease, background .18s ease;
  }

  button:hover { transform: translateY(-2px); background: #ffffff20; }
  button:active { transform: translateY(0); }
  button:focus-visible { outline: 3px solid #71b7ff; outline-offset: 4px; }

  .orbit {
    position: absolute;
    z-index: -1;
    border: 1px solid #8fc7ff2b;
    border-radius: 50%;
  }

  .orbit-one { width: 46vmin; height: 46vmin; top: -18vmin; right: -10vmin; }
  .orbit-two { width: 30vmin; height: 30vmin; bottom: -12vmin; left: -8vmin; }

  .footnote {
    position: fixed;
    right: 18px;
    bottom: 14px;
    margin: 0;
    color: #9db0c8;
    font-size: 12px;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-9px) rotate(2deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .icon { animation: none; }
    button { transition: none; }
  }
</style>
