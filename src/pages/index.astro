---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts');
const featuredPosts = allPosts
  .filter(post => post.data.featured && !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sectionLabels: Record<string, string> = {
  lab: '实验手记',
  study: '通识基础',
  mind: '随想录',
  project: '作品集',
};
---

<BaseLayout title="dlx's Digital Lab">
  <section class="hero">
    <p class="eyebrow">Digital Lab</p>
    <h1>dlx 的数字实验室</h1>
    <p class="tagline">你好，我是 dlx，一名集成电路设计专业学生。<br />
我喜欢把复杂的底层逻辑拆解明白，也喜欢捣鼓好玩的硬件设备。</p>
    <div class="focus-list">
      <span>处理器 / RTL / FPGA / AI 加速器</span>
      <span>正在构建个人 AI 助手 Autumn</span>
    </div>
  </section>

  <section class="threads-section">
    <div class="section-heading">
      <h2>当前主线</h2>
      <span>Current threads</span>
    </div>
    <div class="threads">
      <div class="thread">
        <span class="thread-index">01</span>
        <p><strong>处理器与体系结构</strong><span>一生一芯 · RISC-V · Computer Architecture</span></p>
      </div>
      <div class="thread">
        <span class="thread-index">02</span>
        <p><strong>FPGA 与 RTL</strong><span>Verilog · FPGA · 数字设计</span></p>
      </div>
      <div class="thread">
        <span class="thread-index">03</span>
        <p><strong>AI 与智能计算</strong><span>深度学习 · 神经网络 · AI 加速器</span></p>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <h2>作品与项目</h2>
      <a href="/portfolio">查看作品集 →</a>
    </div>
    <div class="project-grid">
      <article class="project-card project-primary">
        <div class="project-head">
          <h3>Autumn</h3>
          <span class="project-status">Ongoing</span>
        </div>
        <p>跨树莓派、Windows 和移动设备运行的个人 AI 助手系统，尝试把模型、工具、文件和任务组织成一个统一入口。</p>
      </article>

      <article class="project-card">
        <div class="project-head">
          <h3>MajorPath</h3>
          <span class="project-status">Ongoing</span>
        </div>
        <p>帮助高中生看懂大学专业、探索方向，减少盲选的公益网站。</p>
      </article>
    </div>
  </section>

  {featuredPosts.length > 0 && (
    <section class="home-section featured-section">
      <div class="section-heading">
        <h2>精选文章</h2>
        <a href="/posts">全部文章 →</a>
      </div>
      <div class="featured-list">
        {featuredPosts.map(post => (
          <a href={`/posts/${post.id}`} class="featured-row">
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
            </time>
            <div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <span class="featured-section-label">{sectionLabels[post.data.section] ?? post.data.section}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="home-section explore-section">
    <div class="section-heading">
      <h2>浏览栏目</h2>
      <span>Explore</span>
    </div>
    <div class="explore-grid">
      <a href="/lab" class="explore-card">
        <h3>实验手记</h3>
        <p>处理器与体系结构、RTL / FPGA、Linux 工具链、Autumn 与工程实践</p>
      </a>
      <a href="/study" class="explore-card">
        <h3>通识基础</h3>
        <p>课程学习、基础知识、复习整理与阶段性的学习笔记</p>
      </a>
      <a href="/mind" class="explore-card">
        <h3>随想录</h3>
        <p>读书、学习方法，以及一些日常思考</p>
      </a>
      <a href="/portfolio" class="explore-card">
        <h3>作品集</h3>
        <p>项目、实验和长期工程的整理与展示</p>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 50rem;
    padding: 4rem 0 2.8rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin-bottom: 0.8rem;
    font-size: clamp(2rem, 5vw, 2.65rem);
    letter-spacing: -0.04em;
  }

  .tagline {
    max-width: 45rem;
    color: var(--color-accent-strong);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.8;
  }

  .focus-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.2rem;
  }

  .focus-list span {
    padding: 0.34rem 0.62rem;
    border-radius: 2rem;
    background: var(--color-accent-soft);
    color: var(--color-text-muted);
    font-size: 0.73rem;
  }

  .threads-section {
    margin: 0 0 0.6rem;
    padding: 1.55rem 1.5rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-accent-soft) 52%, var(--color-surface));
  }

  .home-section {
    padding: 2.9rem 0 0;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .section-heading > span,
  .section-heading > a {
    margin-left: auto;
    color: var(--color-text-faint);
    font-size: 0.68rem;
  }

  .section-heading > a {
    color: var(--color-accent-strong);
    text-decoration: none;
  }

  .threads {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .thread {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .thread-index {
    flex: 0 0 auto;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .thread p {
    margin: 0;
    color: var(--color-text);
  }

  .thread strong {
    display: block;
    margin-bottom: 0.12rem;
    font-size: 0.84rem;
    font-weight: 600;
  }

  .thread p span {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 0.8rem;
  }

  .project-card {
    min-height: 12.5rem;
    padding: 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: 0.8rem;
    background: var(--color-surface);
    box-shadow: var(--shadow-soft);
  }

  .project-primary {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-accent-soft) 54%, var(--color-surface)),
      var(--color-surface) 56%
    );
  }

  .project-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 2.4rem;
  }

  .project-head h3 {
    margin: 0;
    font-size: 1.18rem;
    letter-spacing: -0.02em;
  }


  .project-status {
    margin-left: auto;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.02em;
  }
  .repo-link {
    margin-left: auto;
    padding: 0.24rem 0.48rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--color-accent-soft) 48%, var(--color-surface));
    color: var(--color-accent-strong);
    font-size: 0.66rem;
    font-weight: 600;
    text-decoration: none;
  }

  .repo-link:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .project-card > p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.79rem;
    line-height: 1.72;
  }

  .featured-list {
    border-top: 1px solid var(--color-border);
  }

  .featured-row {
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr) auto;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
  }

  .featured-row:hover {
    text-decoration: none;
  }

  .featured-row time,
  .featured-section-label {
    padding-top: 0.15rem;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .featured-row h3 {
    margin: 0 0 0.18rem;
    font-size: 0.94rem;
  }

  .featured-row:hover h3 {
    color: var(--color-accent-strong);
  }

  .featured-row p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.77rem;
  }

  .explore-section {
    padding-bottom: 0.6rem;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.7rem;
  }

  .explore-card {
    min-height: 7rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition: border-color 0.15s, transform 0.15s;
  }

  .explore-card:hover {
    border-color: var(--color-accent);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .explore-card h3 {
    margin-bottom: 0.35rem;
    font-size: 0.93rem;
  }

  .explore-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.76rem;
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 3.1rem;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .threads,
    .project-grid,
    .explore-grid {
      grid-template-columns: 1fr;
    }

    .threads {
      gap: 0.7rem;
    }

    .project-card {
      min-height: 0;
    }

    .project-head {
      margin-bottom: 1.5rem;
    }

    .explore-card {
      min-height: 0;
    }

    .featured-row {
      grid-template-columns: 5rem minmax(0, 1fr);
    }

    .featured-section-label {
      display: none;
    }
  }
</style>
