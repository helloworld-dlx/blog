---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="您访问的页面不存在">
  <div class="not-found">
    <h1>404</h1>
    <p>页面不存在或已被移除</p>
    <a href="/">← 返回首页</a>
  </div>
</BaseLayout>

<style>
  .not-found { max-width: 34rem; padding: 5rem 0; }
  .not-found h1 { margin-bottom: 0.65rem; color: var(--color-accent-strong); font-family: var(--font-mono); font-size: 3.2rem; letter-spacing: -0.05em; }
  .not-found p { margin-bottom: 1.3rem; color: var(--color-text-muted); }
  .not-found a { color: var(--color-accent-strong); font-size: 0.85rem; text-decoration: none; }
</style>
