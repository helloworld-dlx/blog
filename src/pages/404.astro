---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="PC 跳到了不存在的地址">
  <div class="not-found">
    <p class="fault">PAGE_FAULT · 404</p>
    <h1>404</h1>
    <h2>PC 跳到了不存在的地址。</h2>
    <p>这条指令不在 ROM 里。<br />也可能是我把页面搬走了。</p>
    <div class="actions">
      <a href="/">← 返回首页</a>
      <a href="/lab">查看实验手记 →</a>
    </div>
    <p class="address">PC = 0x404 · INVALID ADDRESS</p>
  </div>
</BaseLayout>

<style>
  .not-found { max-width: 38rem; padding: 5.4rem 0 4rem; }
  .fault { margin: 0 0 0.45rem; color: var(--color-text-faint); font-family: var(--font-mono); font-size: 0.65rem; letter-spacing: 0.08em; }
  .not-found h1 { margin: 0; color: var(--color-accent-strong); font-family: var(--font-mono); font-size: 3.5rem; letter-spacing: -0.06em; line-height: 1; }
  .not-found h2 { margin: 0.75rem 0 0.65rem; padding: 0; border: 0; background: transparent; color: var(--color-text); font-size: 1.15rem; }
  .not-found > p:not(.fault):not(.address) { margin-bottom: 1.4rem; color: var(--color-text-muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 1rem; }
  .actions a { color: var(--color-accent-strong); font-size: 0.84rem; text-decoration: none; }
  .actions a:hover { text-decoration: underline; }
  .address { margin-top: 2.8rem; color: var(--color-text-faint); font-family: var(--font-mono); font-size: 0.62rem; }
</style>
